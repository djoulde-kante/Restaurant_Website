{
  "name": "diko-restaurant",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:client": "turbo dev --filter=@repo/client",
    "dev:admin": "turbo dev --filter=@repo/admin",
    "dev:api": "turbo dev --filter=@repo/api",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{js,jsx,md}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "postcss-nested": "^6.0.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "turbo": "^1.12.5"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "packageManager": "npm@10.2.3"
}
